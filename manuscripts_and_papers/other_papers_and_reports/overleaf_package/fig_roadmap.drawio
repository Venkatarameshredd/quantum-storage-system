        <!-- Pillar 2 -->
        <mxCell id="p2" value="PILLAR 2: HYBRID KEM&#xa;Dual Classical + Lattice KEM&#xa;&#xa;• Parallel Primitive Pair:&#xa;  - ECDH SECP256R1 (32B)&#xa;  - Kyber-512 ML-KEM (32B)&#xa;• IND-CCA2 Redundancy&#xa;• HKDF-SHA256 Expansion:&#xa;  - Salt: 128-bit Random&#xa;  - Outputs: K_enc || K_auth&#xa;• Benchmark: 1.28 ms&#xa;  - 6.15x Faster than RSA&#xa;  - Key Package: 864 Bytes&#xa;&#xa;[Mapped: Sec 2, Sec 3.4, Sec 8.2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;fontColor=#1E293B;strokeColor=#4A7C59;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9.5;align=left;spacingLeft=8;" vertex="1" parent="frame">
