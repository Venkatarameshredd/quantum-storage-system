        <!-- Pillar 1 -->
        <mxCell id="p1" value="PILLAR 1: AEDE&#xa;Adaptive Decision Engine&#xa;&#xa;• Policy-Driven Mode Selection&#xa;  - Low: ECC-256&#xa;  - Med: Kyber-512&#xa;  - High: Dual Hybrid&#xa;• Dynamic Threshold tau=5MB&#xa;  - 93% Compute Saved at 10MB&#xa;• Workload Latency Savings:&#xa;  - Profile A: -6.88%&#xa;  - Profile B: -54.38%&#xa;  - Profile C: -67.81%&#xa;&#xa;[Mapped: Sec 3.2, Sec 4, Sec 6.3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FA;fontColor=#1E293B;strokeColor=#3B6978;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9.5;align=left;spacingLeft=8;" vertex="1" parent="frame">
