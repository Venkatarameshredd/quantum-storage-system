<mxfile host="app.diagrams.net" modified="2026-10-18T20:48:00.000Z" agent="Mozilla/5.0" version="21.6.5" type="device">
  <diagram id="fig1_hndl_defense" name="HNDL Threat Horizon &amp; Multi-Tier Defense">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- Panel (a): Threat Vector -->
        <mxCell id="box_a" value="Panel (a): The 'Harvest Now, Decrypt Later' (HNDL) Threat Vector" style="swimlane;startSize=30;fillColor=#991B1B;fontColor=#FFFFFF;strokeColor=#7F1D1D;rounded=1;arcSize=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="460" height="550" as="geometry"/>
        </mxCell>
        
        <mxCell id="phase1" value="PHASE 1: Present Classical Era (T0)&#xa;Client uploads data via RSA-3072 / ECC-256&#xa;Passive Adversary intercepts &amp; hoards encrypted traffic&#xa;Encrypted Harvest Data Lake (Petabytes stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#991B1B;align=left;spacingLeft=10;" vertex="1" parent="box_a">
          <mxGeometry x="15" y="50" width="430" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_t1" value="Data Retention Window (10-50 Years)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;dashed=1;fontColor=#64748B;fontSize=10;" edge="1" parent="box_a" source="phase1" target="phase2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="phase2" value="PHASE 2: The Cryptographic Shelf-Life Dilemma (ΔT)&#xa;Long-retention enterprise records: HIPAA (50-yr), Basel III&#xa;Mosca's Theorem: If (Shelf-Life + Migration) &gt; Time to CRQC,&#xa;then data is ALREADY COMPROMISED today!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FBBF24;fontColor=#92400E;align=left;spacingLeft=10;" vertex="1" parent="box_a">
          <mxGeometry x="15" y="180" width="430" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_t2" value="CRQC Hardware Milestone Reached" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;dashed=1;fontColor=#DC2626;fontSize=10;" edge="1" parent="box_a" source="phase2" target="phase3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="phase3" value="PHASE 3: Quantum Era: Retrospective Decryption (TQ)&#xa;Shor's Algorithm deployed: Solves discrete log &amp; IFP in O(n³)&#xa;Asymmetric Key Collapse: RSA &amp; ECC master keys broken&#xa;Catastrophic Historical Exfiltration: Decades of Archives Laid Bare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="box_a">
          <mxGeometry x="15" y="310" width="430" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="summary_a" value="Summary: Classical Cloud Inadequacy&#xa;• Encrypting today with classical ciphers offers zero forward quantum secrecy.&#xa;• Storage systems must deploy quantum-resilient defense BEFORE CRQC horizon." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;align=left;spacingLeft=10;" vertex="1" parent="box_a">
          <mxGeometry x="15" y="430" width="430" height="80" as="geometry"/>
        </mxCell>

        <!-- Panel (b): Defense Architecture -->
        <mxCell id="box_b" value="Panel (b): Proposed Multi-Tier Proactive Cloud Defense Lifecycle" style="swimlane;startSize=30;fillColor=#1E3A8A;fontColor=#FFFFFF;strokeColor=#172554;rounded=1;arcSize=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="470" height="550" as="geometry"/>
        </mxCell>

        <mxCell id="tier1" value="TIER 1: 0.089 ms Early-Drop Outer HMAC Filter&#xa;Verifies HMAC envelope before invoking heavy crypto. Drops forged payloads; stops DoS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;fontColor=#166534;align=left;spacingLeft=10;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="50" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;" edge="1" parent="box_b" source="tier1" target="tier2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="tier2" value="TIER 2: Adaptive Encryption Decision Engine (AEDE)&#xa;Dynamic routing by sensitivity σ and network packet loss telemetry (Low / Med / High)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;align=left;spacingLeft=10;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="130" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;" edge="1" parent="box_b" source="tier2" target="tier3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="tier3" value="TIER 3: Dual-Key Hybrid KEM (SECP256R1 + Kyber-512 via HKDF)&#xa;Combines classical ECDH and lattice Kyber-512. IND-CCA2 security even if one fails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;fontColor=#5B21B6;align=left;spacingLeft=10;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="210" width="440" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;" edge="1" parent="box_b" source="tier3" target="tier4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="tier4" value="TIER 4: Zero-Trust Shamir (2,3) Key Splitting over GF(257)&#xa;Splits master key K_enc across decoupled header, database, and client domains." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#FDE047;fontColor=#854D0E;align=left;spacingLeft=10;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="295" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arrow_d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA8A04;" edge="1" parent="box_b" source="tier4" target="tier5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="tier5" value="TIER 5: Cryptographic Hash-Chain &amp; Real-Time Anomaly Detection&#xa;Append-only SHA-256 ledger with sliding-window Bayesian anomaly scoring." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;align=left;spacingLeft=10;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="375" width="440" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="outcome" value="Provable Forward Secrecy &amp; Operational Guarantee:&#xa;• Intercepted ciphertexts remain cryptographically opaque permanently.&#xa;• Resilient against both present eavesdroppers and future CRQC adversaries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;fontColor=#065F46;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="box_b">
          <mxGeometry x="15" y="455" width="440" height="75" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
